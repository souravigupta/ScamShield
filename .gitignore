<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width,initial-scale=1">
<title>ScamShield — Scam & Claim Risk Verifier</title>
<style>
:root{
 --bg:#f6f8fb;--card:#fff;--ink:#1f2a3a;--muted:#687386;--line:#dfe5ed;
 --blue:#2f5b96;--teal:#257d7a;--red:#c04343;--amber:#c58a2d;--green:#2d7a55;
}
*{box-sizing:border-box} body{margin:0;background:var(--bg);color:var(--ink);font-family:Inter,ui-sans-serif,system-ui,-apple-system,BlinkMacSystemFont,"Segoe UI",sans-serif}
header{background:#fff;border-bottom:1px solid var(--line);padding:18px 5vw;display:flex;justify-content:space-between;align-items:center}
.brand{font-size:24px;font-weight:800;letter-spacing:.3px}.brand span{color:var(--teal)}
.badge{font-size:12px;font-weight:700;color:var(--blue);background:#eaf0f8;padding:7px 11px;border-radius:999px}
main{max-width:1180px;margin:34px auto;padding:0 22px}
.hero h1{font-size:38px;margin:0 0 10px}.hero p{color:var(--muted);font-size:16px;max-width:820px;line-height:1.6}
.grid{display:grid;grid-template-columns:1fr 1fr;gap:20px;margin-top:24px}
.card{background:var(--card);border:1px solid var(--line);border-radius:16px;padding:22px;box-shadow:0 4px 16px rgba(30,45,65,.04)}
.card h2{font-size:18px;margin:0 0 16px}.hint{font-size:13px;color:var(--muted);line-height:1.5}
textarea{width:100%;min-height:190px;border:1px solid var(--line);border-radius:12px;padding:14px;font:inherit;resize:vertical;outline:none}
textarea:focus{border-color:var(--blue);box-shadow:0 0 0 3px #eaf0f8}
.actions{display:flex;gap:10px;flex-wrap:wrap;margin-top:12px}
button{border:0;border-radius:10px;padding:11px 16px;font-weight:700;cursor:pointer}
.primary{background:var(--blue);color:#fff}.secondary{background:#eef2f7;color:var(--ink)}.ghost{background:#fff;border:1px solid var(--line)}
.drop{border:2px dashed #cbd4df;border-radius:12px;padding:22px;text-align:center;margin-top:12px}
input[type=file]{display:none}.filebtn{display:inline-block;background:#eef2f7;padding:10px 14px;border-radius:9px;font-weight:700;cursor:pointer}
.preview{max-height:160px;max-width:100%;margin:14px auto 0;border-radius:10px;display:none}
.result{margin-top:24px;display:none}.result.show{display:block}
.scoreRow{display:flex;align-items:center;gap:24px}
.score{width:120px;height:120px;border-radius:50%;display:flex;align-items:center;justify-content:center;flex-direction:column;font-weight:800;border:10px solid #f0cfcf}
.score strong{font-size:30px}.score small{font-size:11px;color:var(--muted)}
.level{font-size:25px;font-weight:800;color:var(--red)}.sub{color:var(--muted);margin-top:5px}
.cols{display:grid;grid-template-columns:1.1fr .9fr;gap:18px;margin-top:20px}
.flag{display:flex;justify-content:space-between;gap:15px;padding:12px 0;border-bottom:1px solid var(--line)}
.flag:last-child{border-bottom:0}.tag{font-size:11px;font-weight:800;padding:5px 8px;border-radius:999px;background:#f8e7e7;color:var(--red);white-space:nowrap}
.ver{padding:13px;border:1px solid var(--line);border-radius:10px;margin-bottom:10px}.ver b{display:block;margin-bottom:5px}.status{font-size:12px;font-weight:800;color:var(--amber)}
.safe{background:#eef7f3;border-color:#cfe6db}.safe b{color:var(--green)}
.disclaimer{font-size:12px;color:var(--muted);margin-top:18px;line-height:1.5}
.spinner{display:none;margin-top:12px;color:var(--muted);font-size:13px}.spinner.show{display:block}
@media(max-width:800px){.grid,.cols{grid-template-columns:1fr}.hero h1{font-size:30px}}
</style>
</head>
<body>
<header>
  <div class="brand">Scam<span>Shield</span></div>
  <div class="badge">SANGYAN • Track A</div>
</header>

<main>
<section class="hero">
  <h1>Scam & Claim Risk Verifier</h1>
  <p>Check suspicious financial messages, claims and links before money changes hands. ScamShield combines content-level red-flag analysis with claim verification and explains the evidence behind its risk assessment.</p>
</section>

<section class="grid">
  <div class="card">
    <h2>1. Submit suspicious content</h2>
    <div class="hint">Paste a WhatsApp/Telegram message, social-media claim, or suspicious text.</div>
    <textarea id="input" placeholder="Example: SEBI registered advisor. Guaranteed 30% returns. Join our Telegram VIP group and pay ₹5,000 to activate your account."></textarea>
    <div class="drop">
      <label class="filebtn" for="file">Upload screenshot</label>
      <input id="file" type="file" accept="image/*">
      <div class="hint" style="margin-top:8px">OCR is attempted in-browser when Tesseract.js is available.</div>
      <img id="preview" class="preview">
    </div>
    <div class="actions">
      <button class="primary" onclick="analyze()">Analyze risk</button>
      <button class="secondary" onclick="loadDemo()">Load demo case</button>
      <button class="ghost" onclick="clearAll()">Clear</button>
    </div>
    <div id="ocr" class="spinner">Reading screenshot…</div>
  </div>

  <div class="card">
    <h2>2. What ScamShield checks</h2>
    <div class="ver"><b>Claim verification</b><span class="status">Official-source check • prototype layer</span><div class="hint">Extracts names, registration claims and links. Unverified claims are clearly marked rather than treated as proven fraud.</div></div>
    <div class="ver"><b>AI/NLP risk profiling</b><span class="status">Explainable content analysis</span><div class="hint">Looks for guaranteed-return language, urgency, impersonation, payment pressure and investment solicitation.</div></div>
    <div class="ver safe"><b>Safety-first output</b><div class="hint">No stock tips, buy/sell/hold recommendations, price predictions, or investment promotion.</div></div>
  </div>
</section>

<section id="result" class="result">
  <div class="card">
    <div class="scoreRow">
      <div id="scoreCircle" class="score"><strong id="score">0</strong><small>/ 100</small></div>
      <div><div id="level" class="level">Risk assessment</div><div id="summary" class="sub"></div></div>
    </div>
    <div class="cols">
      <div>
        <h2>Detected red flags</h2>
        <div id="flags"></div>
      </div>
      <div>
        <h2>Claim & link verification</h2>
        <div id="verification"></div>
        <h2 style="margin-top:22px">Safe next steps</h2>
        <div id="steps"></div>
      </div>
    </div>
    <div class="disclaimer"><b>Prototype note:</b> The score is a risk assessment, not a legal determination that content is fraudulent. Verification is limited to the sources and checks implemented in this prototype. Never share OTPs, passwords or sensitive financial information with unsolicited contacts.</div>
  </div>
</section>
</main>

<script>
const patterns=[
 {name:"Guaranteed / unusually high returns", re:/(guaranteed|assured|fixed)\s*(return|profit|income)|\b\d{2,3}\s*%\s*(return|profit|monthly|daily)/i, pts:24, why:"Promises of guaranteed or unusually high returns are a strong scam-risk signal."},
 {name:"Urgency / scarcity", re:/(limited|only|last|act now|hurry|immediately|today only|urgent|slots?)/i, pts:14, why:"Pressure to act quickly can reduce deliberate verification."},
 {name:"Telegram / WhatsApp investment solicitation", re:/(telegram|whatsapp).{0,60}(vip|signal|tip|investment|profit)|\b(vip|signal|tip)\s*(group|channel)/i, pts:17, why:"Investment solicitation through messaging groups is a known risk vector in the challenge."},
 {name:"Upfront payment request", re:/(pay|payment|deposit|transfer).{0,60}(activate|release|withdraw|account|fee|tax)|activation\s*(fee|payment)/i, pts:20, why:"Unexpected upfront payments are a high-risk pattern."},
 {name:"Regulatory-authority claim", re:/(sebi|rbi|nsdl|registered|registration\s*(no|number)|authori[sz]ed)/i, pts:8, why:"Regulatory claims should be independently verified."},
 {name:"Impersonation / authority language", re:/(official|officer|advisor|manager|representative|your\s+account\s+manager|sebi\s+official)/i, pts:9, why:"Authority or impersonation language can be used to create false trust."},
 {name:"Investment solicitation", re:/(invest|investment|stock|share|returns?|profit|trading|scheme|portfolio)/i, pts:6, why:"The content is explicitly soliciting or discussing an investment opportunity."}
];

function loadDemo(){
 document.getElementById('input').value="SEBI registered advisor. Guaranteed 30% monthly returns. Limited slots! Join our Telegram VIP group and pay ₹5,000 to activate your account.";
 analyze();
}
function clearAll(){
 document.getElementById('input').value=""; document.getElementById('result').classList.remove('show');
 document.getElementById('preview').style.display='none'; document.getElementById('file').value="";
}
document.getElementById('file').addEventListener('change', async e=>{
 const f=e.target.files[0]; if(!f)return;
 const img=document.getElementById('preview'); img.src=URL.createObjectURL(f); img.style.display='block';
 document.getElementById('ocr').classList.add('show');
 if(window.Tesseract){
   try{
    const {data:{text}}=await Tesseract.recognize(f,'eng');
    document.getElementById('input').value=text.trim();
   }catch(err){ document.getElementById('ocr').textContent="OCR could not read this image. You can paste the message manually."; return; }
 }
 document.getElementById('ocr').classList.remove('show');
});
function analyze(){
 const text=document.getElementById('input').value.trim();
 if(!text){ alert("Paste a suspicious message or load the demo case first."); return; }
 let hits=[], score=0;
 patterns.forEach(p=>{if(p.re.test(text)){hits.push(p);score+=p.pts;}});
 // verification-style signals
 const hasReg=/\b(sebi|rbi|nsdl)\b/i.test(text);
 const hasNumber=/(registration|reg\.?\s*(no|number)|licen[cs]e)\D{0,8}[A-Z0-9-]{4,}/i.test(text);
 let verification=[];
 if(hasReg){
   verification.push({title:"Regulatory claim", status: hasNumber ? "Needs independent verification" : "Claim detected — no registration number supplied", body:"The prototype does not treat a regulatory claim as proof of legitimacy."});
 } else {
   verification.push({title:"Regulatory claim", status:"None detected", body:"No SEBI/RBI/NSDL authority claim was detected in the submitted text."});
 }
 const urls=text.match(/https?:\/\/[^\s)]+/gi)||[];
 if(urls.length) verification.push({title:"Link detected",status:"Requires source/domain verification",body:urls[0]});
 else verification.push({title:"Link check",status:"No URL detected",body:"No link was supplied for domain-level checks."});
 score=Math.min(100,Math.max(5,score));
 let level=score>=70?"HIGH RISK":score>=40?"MEDIUM RISK":"LOWER RISK";
 let color=score>=70?"#c04343":score>=40?"#c58a2d":"#2d7a55";
 document.getElementById('score').textContent=score;
 document.getElementById('scoreCircle').style.borderColor=color+"55";
 document.getElementById('level').textContent=level;
 document.getElementById('level').style.color=color;
 document.getElementById('summary').textContent=hits.length?`${hits.length} risk signal${hits.length>1?'s':''} detected. Review the evidence before taking action.`:"No major red-flag pattern detected by this prototype. This is not proof of legitimacy.";
 document.getElementById('flags').innerHTML=hits.length?hits.map(h=>`<div class="flag"><div><b>${h.name}</b><div class="hint">${h.why}</div></div><span class="tag">+${h.pts}</span></div>`).join(""):`<div class="hint">No configured red flags matched. Always verify financial claims independently.</div>`;
 document.getElementById('verification').innerHTML=verification.map(v=>`<div class="ver"><b>${v.title}</b><span class="status">${v.status}</span><div class="hint">${v.body}</div></div>`).join("");
 const steps=score>=70?["Do not transfer money or pay an activation/withdrawal fee.","Verify the person/entity through official channels independently.","Do not share OTPs, passwords or sensitive financial information."]:["Do not rely on the message alone.","Verify important claims using trusted official sources.","If the content asks for money or credentials, pause and verify first."];
 document.getElementById('steps').innerHTML=steps.map(s=>`<div class="ver safe"><div class="hint">✓ ${s}</div></div>`).join("");
 document.getElementById('result').classList.add('show');
 document.getElementById('result').scrollIntoView({behavior:'smooth',block:'start'});
}
</script>
<script src="https://cdn.jsdelivr.net/npm/tesseract.js@5/dist/tesseract.min.js"></script>
</body>
</html>
